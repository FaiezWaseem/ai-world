# OpenAI-compatible API (Responses API: POST {BASE_URL}/responses)
BASE_URL=https://api.flash-router.site/v1
API_KEY=your_api_key_here
MODEL=gpt-5.5

# How many AI citizens to spawn in the world
AGENT_COUNT=4

# How long the server waits for the model (ms). Cold starts need 60–120s+.
LLM_TIMEOUT_MS=120000
